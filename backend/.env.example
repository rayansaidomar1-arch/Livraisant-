# ── Base de données (fournie automatiquement par Clever Cloud à la création de l'add-on Postgres) ──
POSTGRESQL_ADDON_URI=postgresql://user:password@host:port/dbname
DATABASE_URL=${POSTGRESQL_ADDON_URI}

# ── Auth maison (remplace Supabase Auth) ──
JWT_SECRET=change-me-generate-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-another-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# ── Google OAuth (remplace sbSignInWithGoogle) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.livraisante.fr/auth/google/callback

# ── Stripe (remplace create-payment-intent + stripe-webhook) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend (emails transactionnels — remplace send-email) ──
RESEND_API_KEY=
EMAIL_FROM=Livraisanté <contact@livraisante.fr>

# ── Web Push / VAPID (remplace send-push) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@livraisante.fr

# ── CORS ──
FRONTEND_ORIGIN=https://livraisante.fr

# ── Divers ──
PORT=8080
NODE_ENV=production
