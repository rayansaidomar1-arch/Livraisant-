# ── Base de données santé (Clever Cloud PostgreSQL Paris — HDS) ──
# POSTGRESQL_ADDON_* est injecté automatiquement par l'add-on Postgres une fois
# celui-ci lié à l'application : rien à saisir à la main côté Clever Cloud.
POSTGRESQL_ADDON_URI=postgresql://user:password@host:port/dbname
#
# ⚠️ Prisma lit `env("DATABASE_URL")`. Ne PAS écrire `DATABASE_URL=${POSTGRESQL_ADDON_URI}`
# dans les variables Clever Cloud : la référence n'y est pas développée, Prisma
# reçoit la chaîne littérale et échoue avec « the URL must start with the protocol
# postgresql:// » (P1012). Il faut y recopier l'URI complète de l'add-on.
# En local (.env, chargé par dotenv) l'expansion ne se fait pas non plus : même règle.
# À recopier donc si le mot de passe de l'add-on est un jour régénéré.
DATABASE_URL=postgresql://user:password@host:port/dbname

# ── Supabase (architecture hybride : Supabase reste le fournisseur d'identité) ──
# Ce backend ne gère PAS l'authentification : il vérifie les JWT ES256 émis par
# Supabase via son endpoint JWKS public — aucun secret de signature à stocker ici.
# Project Settings → API → « JWT Keys » / URL de la forme :
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Connexion Postgres en lecture (profiles.role, drivers.active,
# push_subscriptions, products, auth.mfa_factors) — Project Settings → Database.
#
# ⚠️ Passer par le POOLER, pas par l'hôte direct : `db.<project-ref>.supabase.co`
# ne publie qu'un enregistrement AAAA (IPv6), injoignable depuis Clever Cloud.
# Le pooler, lui, répond en IPv4. Deux différences à ne pas rater : l'utilisateur
# devient `postgres.<project-ref>` (et non `postgres`), et la région fait partie
# du nom d'hôte. Le préfixe est `aws-0` ou `aws-1` selon l'âge du projet ; en cas
# d'erreur « Tenant or user not found », c'est l'autre qu'il faut.
# Port 5432 = mode session, remplacement direct. Le 6543 (mode transaction) tient
# plus de connexions mais ne conserve aucun état de session.
# Dashboard → Connect → Session pooler pour l'URI exacte.
SUPABASE_DB_URI=postgresql://postgres.<project-ref>:password@aws-1-<région>.pooler.supabase.com:5432/postgres
# Certificat de l'autorité Supabase (contenu PEM, Settings → Database → SSL
# configuration → Download certificate). SANS cette variable la connexion accepte
# n'importe quel certificat : interception possible sur les rôles et emails qui y
# transitent. La même autorité signe l'hôte direct et le pooler.
# Les variables d'environnement Clever Cloud étant mono-ligne, le PEM s'y colle
# avec des « \n » littéraux — lib/supabaseDb.js rétablit les sauts de ligne.
SUPABASE_DB_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Nombre max de connexions ouvertes par instance (défaut 5) — Supabase plafonne
# le total par projet, à ajuster si plusieurs instances tournent en parallèle.
SUPABASE_DB_POOL_MAX=5

# ── Stripe (remplace create-payment-intent + stripe-webhook) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend (emails transactionnels — remplace send-email) ──
RESEND_API_KEY=
EMAIL_FROM=Livraisanté <administratif@livraisante.fr>

# ── Web Push / VAPID (remplace send-push) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:administratif@livraisante.fr

# ── CORS ──
FRONTEND_ORIGIN=https://livraisante.fr

# ── Divers ──
PORT=8080
NODE_ENV=production

# ── Spécifique au déploiement Clever Cloud (à ne pas mettre dans un .env local) ──
# Le dépôt est un monorepo : le backend n'est pas à la racine.
APP_FOLDER=backend
# Migrations appliquées avant le démarrage. ⚠️ Le hook s'exécute à la RACINE du
# dépôt, pas dans APP_FOLDER — d'où le `cd backend` sans lequel npm ne trouve pas
# package.json (« ENOENT: no such file or directory, open '…/package.json' »).
CC_PRE_RUN_HOOK=cd backend && npm run prisma:migrate
