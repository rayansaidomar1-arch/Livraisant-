// ═══════════════════════════════════════════════════════════════════════
// Livraisanté — Schéma Prisma (Clever Cloud PostgreSQL)
// Remplace la base Supabase. Statut des modèles :
//   [CONFIRMÉ]    = copié depuis une migration SQL Supabase existante
//   [À VÉRIFIER]  = déduit des policies RLS / du code frontend, colonnes
//                   exactes à confirmer avec un export pg_dump --schema-only
//                   de la base Supabase actuelle avant migration définitive
// ═══════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth maison (remplace auth.users de Supabase) ── [NOUVEAU]
enum Role {
  patient
  pharmacie
  livreur
  club
  pro
  admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash") // null si compte créé via Google OAuth uniquement
  googleId     String?  @unique @map("google_id")
  role         Role     @default(patient)
  nom          String?
  telephone    String?
  emailConfirmedAt DateTime? @map("email_confirmed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  pharmacy          Pharmacy?
  driver            Driver?
  club              Club?
  healthProfessional HealthProfessional?
  ordersAsPatient   Order[]             @relation("OrderPatient")
  appointments      Appointment[]       @relation("AppointmentPatient")
  clubMemberships   ClubMember[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

// ── pharmacies [À VÉRIFIER — colonnes nom/adresse/siret/etc. à confirmer] ──
model Pharmacy {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nom        String?
  adresse    String?
  ville      String?
  codePostal String?  @map("code_postal")
  telephone  String?
  siret      String?
  createdAt  DateTime @default(now()) @map("created_at")

  orders  Order[]

  @@map("pharmacies")
}

// ── orders [À VÉRIFIER — items/patient probablement en JSONB dans l'original] ──
enum OrderStatus {
  en_attente
  validee
  prete
  en_livraison
  livree
  refusee
}

model Order {
  id         String      @id @default(uuid())
  patientId  String      @map("patient_id")
  patient    User        @relation("OrderPatient", fields: [patientId], references: [id])
  pharmacyId String?     @map("pharmacy_id")
  pharmacy   Pharmacy?   @relation(fields: [pharmacyId], references: [id])
  status     OrderStatus @default(en_attente)
  items      Json?
  patientSnapshot Json?  @map("patient_snapshot") // copie dénormalisée (nom, email, adresse) au moment de la commande
  totalEur   Decimal?    @map("total_eur") @db.Decimal(10, 2)
  trackId    String?     @map("track_id")
  kind       String?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@map("orders")
}

// ── drivers [À VÉRIFIER] ──
model Driver {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  vehicule  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("drivers")
}

// ── clubs [À VÉRIFIER] ──
model Club {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nom       String?
  createdAt DateTime @default(now()) @map("created_at")

  members            ClubMember[]
  healthProfessionals HealthProfessional[]

  @@map("clubs")
}

// ── club_members [À VÉRIFIER] ──
model ClubMember {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId    String   @map("club_id")
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  status    String?  @default("actif")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, clubId])
  @@map("club_members")
}

// ── club_join_requests [À VÉRIFIER — structure encore inconnue] ──
model ClubJoinRequest {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  clubId    String   @map("club_id")
  status    String   @default("en_attente")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("club_join_requests")
}

// ── health_professionals [À VÉRIFIER] ──
model HealthProfessional {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId     String?  @map("club_id")
  club       Club?    @relation(fields: [clubId], references: [id])
  specialite String?
  validated  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  appointments Appointment[]

  @@map("health_professionals")
}

// ── appointments [À VÉRIFIER] ──
model Appointment {
  id        String   @id @default(uuid())
  patientId String   @map("patient_id")
  patient   User     @relation("AppointmentPatient", fields: [patientId], references: [id])
  proId     String   @map("pro_id")
  pro       HealthProfessional @relation(fields: [proId], references: [id])
  date      DateTime?
  status    String?  @default("en_attente")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("appointments")
}

// ── settlements [À VÉRIFIER — structure encore inconnue, table de règlement pharmacie/livreur] ──
model Settlement {
  id         String   @id @default(uuid())
  targetType String   @map("target_type") // 'pharmacy' | 'driver'
  targetId   String   @map("target_id")
  montantEur Decimal  @map("montant_eur") @db.Decimal(10, 2)
  periode    String?
  status     String   @default("en_attente")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("settlements")
}

// ── push_subscriptions [CONFIRMÉ — copié de 20260624000001_push_subscriptions.sql] ──
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}
