// ═══════════════════════════════════════════════════════════════════════
// Livraisanté — Schéma Prisma (Clever Cloud PostgreSQL — Paris HDS)
//
// ARCHITECTURE HYBRIDE (2026-07-18) : Supabase reste l'IdP (auth.users,
// JWT). Seules les données de santé sensibles + les tables qui en
// dépendent directement vivent ici, dans la base certifiée HDS.
// Le backend vérifie les JWT émis par Supabase (SUPABASE_JWT_SECRET) —
// il ne gère PAS l'authentification lui-même.
//
// Toute colonne "xxxId" faisant référence à un utilisateur Supabase
// (ex. userId, patientId) est un simple UUID (id de auth.users côté
// Supabase) — PAS de foreign key SQL possible entre les deux bases.
// L'intégrité référentielle vis-à-vis de l'identité est garantie côté
// application (le backend fait confiance au `sub` du JWT vérifié).
//
// Restent sur Supabase (non dupliqués ici) : profiles (identité de
// base), drivers, clubs, club_members, settlements, push_subscriptions.
// ═══════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── health_profiles [NOUVEAU] — remplace profiles.health_profile (Supabase) ──
// Une ligne par patient. Clé = id utilisateur Supabase (auth.users.id).
model HealthProfile {
  userId       String   @id @map("user_id")
  ageRange     String?  @map("age_range")
  pregnancy    String?
  sex          String?
  meds         Json?
  weight       Decimal? @db.Decimal(5, 2)
  height       Decimal? @db.Decimal(5, 2)
  bmi          Decimal? @db.Decimal(5, 2)
  address      String?
  sportLicense String?  @map("sport_license")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("health_profiles")
}

// ── pharmacies [CONFIRMÉ — colonnes alignées sur js/supabase-client.js + index.html] ──
model Pharmacy {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id") // id utilisateur Supabase (role pharmacien)
  nom        String?
  adresse    String?
  ville      String?
  codePostal String?  @map("code_postal")
  telephone  String?
  siret      String?
  rpps       String?
  rppsStatus String?  @map("rpps_status")
  createdAt  DateTime @default(now()) @map("created_at")

  orders Order[]

  @@map("pharmacies")
}

// ── orders [CONFIRMÉ — remplace le localStorage ORDERS ; colonnes lues dans index.html] ──
enum OrderStatus {
  en_attente
  validee
  prete
  en_livraison
  livree
  refusee
}

model Order {
  id              String      @id @default(uuid())
  patientId       String      @map("patient_id") // id utilisateur Supabase (role patient)
  pharmacyId      String?     @map("pharmacy_id")
  pharmacy        Pharmacy?   @relation(fields: [pharmacyId], references: [id])
  driverId        String?     @map("driver_id") // id utilisateur Supabase (role livreur), assigné à la prise en charge
  status          OrderStatus @default(en_attente)
  items           Json?
  patientSnapshot Json?       @map("patient_snapshot") // copie dénormalisée (nom, email, adresse) au moment de la commande — évite un appel à Supabase pour notifier le patient
  totalPrice      Decimal?    @map("total_price") @db.Decimal(10, 2)
  deliveryFee     Decimal?    @map("delivery_fee") @db.Decimal(10, 2)
  trackId         String?     @map("track_id")
  kind            String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([pharmacyId])
  @@index([driverId])
  @@index([status])
  @@map("orders")
}

// ── health_professionals [CONFIRMÉ — colonnes alignées sur js/supabase-client.js] ──
model HealthProfessional {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id") // id utilisateur Supabase (role professionnel_sante)
  clubId            String?  @map("club_id") // id club côté Supabase — pas de FK (base distincte)
  profession        String?
  rpps              String?
  partnerClubs      Json?    @map("partner_clubs")
  validatedByClub   Boolean  @default(false) @map("validated_by_club")
  rejected          Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")

  appointments Appointment[]

  @@map("health_professionals")
}

// ── appointments [CONFIRMÉ — colonnes alignées sur sbInsertAppointment] ──
model Appointment {
  id          String   @id @default(uuid())
  patientId   String   @map("patient_id") // id utilisateur Supabase (role patient)
  proId       String   @map("pro_id")
  pro         HealthProfessional @relation(fields: [proId], references: [id])
  clubId      String?  @map("club_id")
  scheduledAt DateTime? @map("scheduled_at")
  motif       String?
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([proId])
  @@map("appointments")
}
